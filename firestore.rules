rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email_verified == true &&
         request.auth.token.email in ['kjhenseler@gmail.com', 'kenneth@henseler.email'])
      );
    }

    // Public astronomy catalog & light-curve enrichments (written only by Cloud Functions Admin SDK).
    match /objects/{objectId} {
      allow read: if true;
      allow write: if false;

      match /detail/{docId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Pre-aggregated home overview, 90-day trends, and JPL Horizons ephemerides (1-read rollups).
    match /rollups/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Optional signed-in user preferences and synced bookmarks across iOS, Android, and Web.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'min_confidence',
          'max_peak_mag',
          'topics',
          'fcm_tokens',
          'rounded_lat',
          'rounded_lon',
          'scope_preset',
          'updated_at'
        ])
        && (!('fcm_tokens' in request.resource.data) || request.resource.data.fcm_tokens.size() <= 10)
        && (!('rounded_lat' in request.resource.data)
          || (request.resource.data.rounded_lat is number
            && request.resource.data.rounded_lat >= -90
            && request.resource.data.rounded_lat <= 90))
        && (!('rounded_lon' in request.resource.data)
          || (request.resource.data.rounded_lon is number
            && request.resource.data.rounded_lon >= -180
            && request.resource.data.rounded_lon <= 180))
        && (!('scope_preset' in request.resource.data)
          || (request.resource.data.scope_preset is string
            && request.resource.data.scope_preset.size() <= 40));
      allow delete: if isOwner(uid);

      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'object_key',
            'survey',
            'oid',
            'top_class',
            'sso_name',
            'sso_number',
            'created_at'
          ])
          && request.resource.data.object_key == bookmarkId
          && request.resource.data.survey in ['lsst', 'ztf', 'bright_sn', 'bright_neo', 'bright_comet', 'bright_var']
          && request.resource.data.oid is string
          && request.resource.data.oid.size() >= 1
          && request.resource.data.oid.size() <= 64;
        allow delete: if isOwner(uid);
      }
    }

    // Admin ingest runs & append-only audit log (readable only by admin custom claim; written by Admin SDK).
    match /admin_runs/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /audit_log/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
